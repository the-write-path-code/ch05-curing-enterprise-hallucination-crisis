# ==============================================================================
# Environment Configuration Template
# Copy this file to .env and set your API keys:
#   cp .example.env .env
# ==============================================================================

# Google Gemini API Key (Required)
# Used by google-genai for embeddings (gemini-embedding-001) and model inference (gemini-2.5-flash)
# Obtain from: https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key

# Google API Key Alias (Optional)
# Alternative environment variable recognized by google-genai
GOOGLE_API_KEY=your-gemini-api-key

# Serper API Key (Required for external web fallback in CRAG)
# Used in src/retrieval.py for Google web search fallback when context is ambiguous or incorrect
# Obtain from: https://serper.dev
SERPER_API_KEY=your-serper-api-key

# Opik Observability & Tracing (Optional)
# Opik is used to track CRAG and SR-RAG pipeline runs, scores, and evaluations.
# Obtain from: https://www.comet.com/site/products/opik/
# OPIK_API_KEY=your-opik-api-key
# OPIK_WORKSPACE=your-opik-workspace
# OPIK_PROJECT_NAME=ch05-crag-srag-pipeline
